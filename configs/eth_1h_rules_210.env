# Strategy ETH 1h ensemble 210 micro-rules
STRATEGY=eth_1h_rules_210_min_votes_1
LOGS_DIR=logs/eth_1h_rules_210
EXECUTION_MODE=limit

# Market
SYMBOL=ethusdt
INTERVAL=1h
POLYMARKET_SLUG_FORMAT=hourly_et
POLYMARKET_SLUG_ASSET=ethereum

# Minimum votes to emit a signal
ENSEMBLE_MIN_VOTES=1

# Position size
TRADE_AMOUNT_PCT=10

# Limit orders
LIMIT_PRICE_REFERENCE=best_ask
LIMIT_PRICE_OFFSET=0.01
LIMIT_PRICE_HIGH_GUARD_ENABLED=false
LIMIT_PRICE_HIGH_GUARD_THRESHOLD=0.60
LIMIT_PRICE_HIGH_GUARD_PRICE=0.55
