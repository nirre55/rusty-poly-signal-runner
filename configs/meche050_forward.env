# Dedicated forward-test recorder. It must never submit a real CLOB order.
STRATEGY=portfolio_meche050
LOGS_DIR=logs/meche050-forward
EXECUTION_MODE=dry-run

# Base values are replaced by portfolio_runner for BTC/ETH 5m/15m.
SYMBOL=btcusdt
INTERVAL=5m
POLYMARKET_SLUG_FORMAT=timestamp
POLYMARKET_SLUG_PREFIX=btc-updown-5m
POLYMARKET_SLUG_ASSET=bitcoin

TRADE_AMOUNT_USDC=10.0
MARTINGALE_MULTIPLIER=1.0
MARTINGALE_MAX_AMOUNT=0.0

# Counterfactual entry metadata. No order is submitted in this profile.
LIMIT_PRICE_FIXED=0.50
LIMIT_PRICE_REFERENCE=best_ask
LIMIT_PRICE_OFFSET=0.00
LIMIT_PRICE_HIGH_GUARD_ENABLED=false

PORTFOLIO_WINDOW_BUDGET_PCT=3.5
PORTFOLIO_SIGNAL_CAP_PCT=1.2
PORTFOLIO_ALLOW_MINIMUM_ABOVE_WINDOW=true
PORTFOLIO_SYNC_GRACE_MS=1250
PORTFOLIO_ENABLED_CONFIG=configs/meche050_forward_enabled.env
PORTFOLIO_DRY_RUN_CAPITAL_USDC=1000.0

# Raw Polymarket market-channel recorder.
PORTFOLIO_RECORDER_ENABLED=true
PORTFOLIO_RECORDER_PRE_SIGNAL_SECONDS=10
# Resolve and connect before the 10-second ring-buffer window begins.
PORTFOLIO_RECORDER_SETUP_LEAD_SECONDS=20
PORTFOLIO_RECORDER_ACTIVATION_GRACE_SECONDS=5
PORTFOLIO_RECORDER_RESOLUTION_TIMEOUT_SECONDS=600
PORTFOLIO_RECORDER_RECONNECT_SECONDS=2
