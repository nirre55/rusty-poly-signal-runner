# Portefeuille unique Mèche 0,50.
# Les secrets Polymarket et BINANCE_WS_URL restent dans .env.
STRATEGY=portfolio_meche050
LOGS_DIR=logs/meche050
EXECUTION_MODE=limit

# Valeurs de base remplacées par portfolio_runner pour chacun des 4 flux.
SYMBOL=btcusdt
INTERVAL=5m
POLYMARKET_SLUG_FORMAT=timestamp
POLYMARKET_SLUG_PREFIX=btc-updown-5m
POLYMARKET_SLUG_ASSET=bitcoin

# Le runner n'utilise pas TRADE_AMOUNT_USDC pour les entrées : W/f décide chaque fenêtre.
TRADE_AMOUNT_USDC=10.0
MARTINGALE_MULTIPLIER=1.0
MARTINGALE_MAX_AMOUNT=0.0

LIMIT_PRICE_FIXED=0.50
LIMIT_PRICE_REFERENCE=best_ask
LIMIT_PRICE_OFFSET=0.00
LIMIT_PRICE_HIGH_GUARD_ENABLED=false

PORTFOLIO_WINDOW_BUDGET_PCT=3.5
PORTFOLIO_SIGNAL_CAP_PCT=1.2
# Force 5 shares at 0.50 even when their minimum exceeds W, while CLOB capital remains available.
PORTFOLIO_ALLOW_MINIMUM_ABOVE_WINDOW=true
PORTFOLIO_SYNC_GRACE_MS=1250
PORTFOLIO_ENABLED_CONFIG=configs/meche050_enabled.env

# Utilisé uniquement avec EXECUTION_MODE=dry-run, car aucun solde CLOB n'est alors demandé.
PORTFOLIO_DRY_RUN_CAPITAL_USDC=1000.0
