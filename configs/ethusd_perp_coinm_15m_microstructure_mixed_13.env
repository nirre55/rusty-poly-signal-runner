# ETHUSD_PERP COIN-M 15m microstructure mixed_13 (frozen, dry-run only)
# The collector reads the causal Binance multi-source snapshot; it is intentionally
# not included in start_all.ps1 or start_all.sh.
STRATEGY=ethusd_perp_coinm_15m_microstructure_mixed_13
LOGS_DIR=logs/ethusd_perp_coinm_15m_microstructure_mixed_13
EXECUTION_MODE=dry_run

# Polymarket ETH 15m market. SYMBOL remains ETHUSDT for the market slug asset;
# the strategy data target itself is the COIN-M ETHUSD_PERP perpetual.
SYMBOL=ethusdt
INTERVAL=15m
POLYMARKET_SLUG_FORMAT=timestamp
POLYMARKET_SLUG_PREFIX=eth-updown-15m

# Kept for common config compatibility; mixed_13 uses EXCLUSIVE_ONLY votes.
ENSEMBLE_MIN_VOTES=1
TRADE_AMOUNT_PCT=1

LIMIT_PRICE_REFERENCE=best_ask
LIMIT_PRICE_OFFSET=0.01
LIMIT_PRICE_HIGH_GUARD_ENABLED=false
LIMIT_PRICE_HIGH_GUARD_THRESHOLD=0.60
LIMIT_PRICE_HIGH_GUARD_PRICE=0.55
