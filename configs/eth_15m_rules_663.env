# Strategy ETH 15m ensemble 663 micro-rules
STRATEGY=eth_15m_rules_663_min_votes_1
LOGS_DIR=logs/eth_15m_rules_663
EXECUTION_MODE=limit

# Market
SYMBOL=ethusdt
INTERVAL=15m
POLYMARKET_SLUG_FORMAT=timestamp
POLYMARKET_SLUG_PREFIX=eth-updown-15m

# Minimum votes to emit a signal
ENSEMBLE_MIN_VOTES=1

# Position size
TRADE_AMOUNT_PCT=10

# Limit orders
LIMIT_PRICE_REFERENCE=best_ask
LIMIT_PRICE_OFFSET=0.01
LIMIT_PRICE_HIGH_GUARD_ENABLED=false
LIMIT_PRICE_HIGH_GUARD_THRESHOLD=0.60
LIMIT_PRICE_HIGH_GUARD_PRICE=0.55
